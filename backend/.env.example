# Шаблон окружения бэкенда. Скопируйте в .env: cp .env.example .env
# Без .env всё тоже работает — docker-compose.yml подставит те же значения по умолчанию.

# PostgreSQL (контейнер postgres из docker-compose.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=credit

# Для запуска вне Docker (uv run --env-file .env …): база и моки на портах из docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:55432/credit
WIREMOCK_URL=http://localhost:8081

# Песочница «Кто я» и отказы на лету (docs/08). В бою — false: эндпоинты песочницы не регистрируются.
DEMO_MODE=true
# Часы демо-мира: моки построены на эту дату.
DEMO_TODAY=2026-10-21

# Доп. слой «умных» функций (docs/03): включается без риска для основы.
FEATURE_K1=true
FEATURE_K2=true
FEATURE_K3=true
FEATURE_K4=false
FEATURE_K5=false

# LLM не в пути решения; OpenAI-compatible (Ollama и т. п.).
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
