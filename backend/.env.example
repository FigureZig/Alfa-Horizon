# Шаблон окружения бэкенда. Скопируйте в .env: cp .env.example .env
# Без .env всё тоже работает — docker-compose.yml подставит те же значения по умолчанию.

# PostgreSQL (контейнер postgres из docker-compose.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=credit

# Порты на хосте. Служебные слушают только BIND_HOST: на сервере наружу смотрит только фронт (WEB_PORT в infra/).
BIND_HOST=127.0.0.1
API_PORT=8000
WIREMOCK_PORT=8081
DB_PORT=55432

# Для запуска вне Docker (uv run --env-file .env …): база и моки на портах из docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:55432/credit
WIREMOCK_URL=http://localhost:8081

# Симулятор: вход пользователем, своя компания, события и отказы на лету (docs/08). В бою — false: его ручек нет.
DEMO_MODE=true
# Часы мира симулятора: моки построены на эту дату.
DEMO_TODAY=2026-10-21
# Подпись JWT при входе пользователем. В бою — свой секрет, не из репозитория.
DEMO_TOKEN_SECRET=dev-only-not-a-secret
# Кем считать запрос без токена в симуляторе, пока никто не вошёл (пользователь из seed/personas.yaml).
DEFAULT_PERSONA=s7
# С каких адресов фронту можно ходить в API напрямую (vite dev — 5173, preview — 4173, стенд infra — 8080).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# Доп. слой «умных» функций (docs/03): включается без риска для основы.
FEATURE_K1=true
FEATURE_K2=true
FEATURE_K3=true
FEATURE_K4=true
FEATURE_K5=true

# LLM не в пути решения; OpenAI-compatible (Ollama и т. п.).
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
