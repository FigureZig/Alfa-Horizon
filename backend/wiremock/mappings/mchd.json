{
  "mappings": [
    {
      "name": "МЧД: поиск по доверителю",
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPath": "/mchd/v1/poa",
        "queryParameters": {
          "principalInn": {
            "matches": "^(7701000019)$"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "bodyFileName": "mchd/{{request.query.principalInn}}.json"
      }
    },
    {
      "name": "МЧД: поиск по доверителю: пусто",
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPath": "/mchd/v1/poa"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "items": []
        }
      }
    },
    {
      "name": "МЧД: не найдена",
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPathPattern": "/mchd/v1/poa/[^/]+"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "jsonBody": {
          "type": "about:blank",
          "title": "Not Found",
          "status": 404,
          "detail": "Запись не найдена"
        }
      }
    }
  ]
}
