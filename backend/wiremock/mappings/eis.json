{
  "mappings": [
    {
      "name": "ЕИС: контракты",
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPath": "/eis/v1/contracts",
        "queryParameters": {
          "supplierInn": {
            "matches": "^(7701000026)$"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "bodyFileName": "eis/{{request.query.supplierInn}}.json"
      }
    },
    {
      "name": "ЕИС: контракты: пусто",
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPath": "/eis/v1/contracts"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "contracts": []
        }
      }
    }
  ]
}
