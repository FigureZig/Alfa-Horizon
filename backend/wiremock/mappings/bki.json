{
  "mappings": [
    {
      "name": "БКИ: кредитный отчёт",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/bki/v1/credit-reports",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.subject.inn",
              "matches": "^(7701000019|7701000026|7701000033|7701000040|7701000058|7701000065|7701000072|7701000080|770100000079|770100000142)$"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "bodyFileName": "bki/{{jsonPath request.body '$.subject.inn'}}.json"
      }
    },
    {
      "name": "БКИ: кредитный отчёт: не найдено",
      "priority": 9,
      "request": {
        "method": "POST",
        "urlPath": "/bki/v1/credit-reports"
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "jsonBody": {
          "type": "about:blank",
          "title": "Not Found",
          "status": 404,
          "detail": "Запись не найдена"
        }
      }
    }
  ]
}
