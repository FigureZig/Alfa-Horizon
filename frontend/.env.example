# Адрес API для браузера. /api — через прокси Vite (pnpm dev, pnpm preview) или nginx стенда infra/.
# Можно указать и прямой адрес: http://localhost:8000/api (CORS бэкенда открыт для 5173 и 4173).
VITE_API_BASE_URL=/api
# Куда прокси Vite отправляет /api при pnpm dev и pnpm preview
API_PROXY_TARGET=http://localhost:8000

# Флаги функций: false — выключено, по умолчанию включено (на бэкенде — свои FEATURE_*)
# K1 — прогноз остатка и кассового разрыва на главной
FEATURE_K1=true
# K2 — кредитное предложение рядом с прогнозом
FEATURE_K2=true
