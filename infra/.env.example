# Окружение стенда на сервере. Скопируйте в .env: cp .env.example .env
# Локально .env не нужен — docker-compose.yml подставит значения по умолчанию.

# Домен, на который Caddy получает сертификат. DNS-запись должна указывать на IP сервера.
DOMAIN=alfahorizon.duckdns.org

# Подпись JWT при входе пользователем — свой случайный секрет, например: openssl rand -hex 32
DEMO_TOKEN_SECRET=

# Пароль базы. Применяется только при первом запуске: у уже созданного тома pgdata пароль прежний.
POSTGRES_PASSWORD=app
