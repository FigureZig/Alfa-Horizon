elBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="block" target="block_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="man" target="man_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_29" value="ручка источника&lt;br&gt;отказ — стаб WireMock из песочницы" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2214;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc9" name="F2 Выдача: деньги ровно один раз"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="F2. Выдача: деньги ровно один раз" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1490" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Деньги ровно один раз.&lt;/b&gt; Выдача — единственная операция с необратимым побочным эффектом, поэтому: (1) один ключ идемпотентности на выдачу, повтор — только с тем же ключом (kb/10_sources.md P3); (2) если ответа нет (таймаут, обрыв), сначала &lt;b&gt;сверка статуса&lt;/b&gt; по ключу, и только потом повтор; (3) бизнес-отказ АБС не ретраим; (4) дедлайн → UNDER_REVIEW с флагом DISBURSE_ERROR, аналитик видит журнал попыток.&lt;br&gt;&lt;b&gt;Как показать (N7):&lt;/b&gt; песочница ставит в WireMock сценарий «обрыв после списания»: POST в состоянии Started → CONNECTION_RESET_BY_PEER и переход в disbursed; GET статуса в disbursed → DISBURSED. Продукт делает сверку и переводит заявку в ISSUED без повторного списания. Ничего не перезапускается.&lt;br&gt;&lt;b&gt;Перед выдачей&lt;/b&gt; — перепроверка стоп-факторов по свежим данным (ГК ст. 821 п. 1); источник недоступен → удержание (BLOCK) → дедлайн → UNDER_REVIEW (F1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1490" height="110" as="geometry"/></mxCell><mxCell id="wk" value="Worker: выдача&lt;br&gt;&lt;small&gt;integrations · АБС&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="1490" height="300" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="1490" height="70" as="geometry"/></mxCell><mxCell id="s" value="SIGNED: перепроверка пройдена" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="230.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="key" value="Ключ идемпотентности&lt;br&gt;&lt;small&gt;один на выдачу: id заявки&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="post" value="POST /abs/v1/loans/{id}/disburse&lt;br&gt;&lt;small&gt;Idempotency-Key, таймаут 5 с&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g" value="Ответ АБС?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;labelWidth=90;" vertex="1" parent="1"><mxGeometry x="722.5" y="225.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="open" value="Кредит открыт: график (loans)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="ok" value="ISSUED" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=terminate;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="230.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="fail" value="UNDER_REVIEW: бизнес-отказ АБС, без повторов" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;labelBackgroundColor=#ffffff;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;labelWidth=110;" vertex="1" parent="1"><mxGeometry x="892.5" y="310.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="rec" value="Сверка: GET статуса по ключу&lt;br&gt;&lt;small&gt;прошла ли выдача?&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="380.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Выдача прошла?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.g