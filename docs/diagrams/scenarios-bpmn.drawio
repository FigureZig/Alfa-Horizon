;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev_s" target="ev_w"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2142.5" y="250"/><mxPoint x="2142.5" y="512"/></Array></mxGeometry></mxCell><mxCell id="flow_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev_w" target="ev_r"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2320.5" y="512"/><mxPoint x="2320.5" y="774"/></Array></mxGeometry></mxCell><mxCell id="flow_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev_r" target="ev_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_s" target="f_w"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2127.5" y="330"/><mxPoint x="2127.5" y="592"/></Array></mxGeometry></mxCell><mxCell id="flow_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_w" target="f_r"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2310.5" y="592"/><mxPoint x="2310.5" y="854"/></Array></mxGeometry></mxCell><mxCell id="flow_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_r" target="f_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_s" target="r_w"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2112.5" y="410"/><mxPoint x="2112.5" y="672"/></Array></mxGeometry></mxCell><mxCell id="flow_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_w" target="r_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_22" value="WireMock admin: POST /__admin/mappings&lt;br&gt;мок банка: персона, доступы, транзакции" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3922;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mat" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_23" value="ручки реестров (kb/09)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.4546;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc3" name="E1 Экспертная система движка"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="E1. Движок решения — экспертная система: факты → правила → таблицы → исход" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2480" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; как работает движок решения (kb/04_decision_engine.md). Один движок, два режима: &lt;b&gt;commit&lt;/b&gt; — решение по заявке, пишется в БД и аудит; &lt;b&gt;simulate&lt;/b&gt; — предодобрение U1, оффер K2, путь к одобрению K3, ценность информации VOI, без записи. Поэтому показанное заранее совпадает с итогом, если не появились новые данные.&lt;br&gt;&lt;b&gt;Факты&lt;/b&gt; — значение + источник + дата + TTL; состояние трёхзначное (KNOWN · STALE · UNKNOWN), условия считаются в логике Клини. &lt;b&gt;Прямой вывод&lt;/b&gt; до неподвижной точки даёт производные факты: «крупная сделка» (14-ФЗ ст. 46), «нужны оба директора» (ГК ст. 53), «требуется согласие ОСУ», стоп-факторы. &lt;b&gt;Таблицы DMN&lt;/b&gt;: лимит — минимум из капов (обороты, платёжная способность, максимум продукта), ставка — КС + отраслевой спред + спред за риск.&lt;br&gt;&lt;b&gt;Политика факта&lt;/b&gt; — fallback внутри базы знаний: если факт неизвестен или устарел, правило знает, что делать (ASK, ASSUME_STRICT, WAIT, PROVISIONAL, BLOCK, MANUAL; см. F1). &lt;b&gt;VOI&lt;/b&gt;: спрашиваем клиента, только если неизвестный факт меняет исход. &lt;b&gt;K3&lt;/b&gt;: перебор действий клиента через simulate, показываем 1–3 с эффектом.&lt;br&gt;&lt;b&gt;Откуда:&lt;/b&gt; политики срабатывания DMN, прямой вывод и Rete, контрфактические объяснения, ценность информации — kb/10_sources.md (P10–P13). Скоринг — балльная карта за портом RiskModel (kb/12_scoring.md)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2480" height="140" as="geometry"/></mxCell><mxCell id="sys" value="Движок решения&lt;br&gt;&lt;small&gt;decisioning: commit | simulate&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="2480" height="262" as="geometry"/></mxCell><mxCell id="k" value="Доп. слой K&lt;br&gt;&lt;small&gt;K3 через simulate&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f3eef8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="2480" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="2480" height="70" as="geometry"/></mxCell><mxCell id="s" value="Запрос решения&lt;br&gt;&lt;small&gt;commit — заявка; simulate — U1, K2, K3, VOI&lt;/small&gt;" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="260.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="f" value="1. Собрать факты&lt;br&gt;&lt;small&gt;снапшоты + источник, дата, TTL&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="cl" value="2. Классифицировать&lt;br&gt;&lt;small&gt;KNOWN · STALE · UNKNOWN&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="fc" value="3. Прямой вывод до неподвижной точки&lt;br&gt;&lt;small&gt;стоп-правила, производные факты, требования&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="tb" value="4. Таблицы DMN&lt;br&gt;&lt;small&gt;лимит = COLLECT MIN(капы) · ставка UNIQUE · срок&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="opt" value="5. Оптимизатор оферты&lt;br&gt;&lt;small&gt;как просили · срок · сумма · продукт · условно + варианты&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="voi" value="6. VOI: неизвестное меняет исход?&lt;br&gt;&lt;small&gt;simulate при лучшем и худшем значении&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1172.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="vg" value="Меняет?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="1382.5" y="255.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="pol" value="Политика факта&lt;br&gt;&lt;small&gt;ASK · ASSUME_STRICT · WAIT · PROVISIONAL · BLOCK · MANUAL&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502.5" y="330.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="out" value="7. Исход по приоритету&lt;br&gt;&lt;small&gt;REJECT &gt; INFO &gt; MANUAL &gt; CONDITIONAL &gt; COUNTER &gt; APPROVE&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1667.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="tr" value="8. Трасса и reason codes&lt;br&gt;&lt;small&gt;правило, вход, норма, текст&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1832.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="mg" value="Режим?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="2042.5" y="255.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="save" value="Записать решение&lt;br&gt;&lt;small&gt;версия политики, хэш входа, снапшоты → decision.made&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2162.5" y="250.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="e1" value="→ D1: исходы" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2377.5" y="260.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="ret" value="Вернуть результат без записи" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2162.5" y="330.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="e2" value="→ U1, K2, K3, VOI" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2377.5" y="340.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k3s" value="Отказ или контрпредложение (D2, D4)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=message;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="562.5" y="522.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k3l" value="&lt;b&gt;K3&lt;/b&gt; Рычаги клиента&lt;br&gt;&lt;small&gt;сумма↓ срок↑ поручитель залог недоимка обороты ждать&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="512.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3c" value="Движок в режиме simulate&lt;br&gt;&lt;small&gt;каждая комбинация ≤ 2 рычагов&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;bpmnShapeType=call;taskMarker=abstract;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="512.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3r" value="&lt;b&gt;K3&lt;/b&gt; Топ-3 по эффекту и цене&lt;br&gt;&lt;small&gt;неустранимое — честно&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="512.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3e" value="→ экран D2 или D4" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1222.5" y="522.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="flow_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f" target="cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl" target="fc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fc" target="tb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tb" target="opt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="opt" target="voi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="voi" target="vg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vg" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vg" target="pol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pol" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="out" target="tr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tr" target="mg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_13" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mg" target="save"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_14" value="simulate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mg" target="ret"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="save" target="e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ret" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3s" target="k3l"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3l" target="k3c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3c" target="k3r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3r" target="k3e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_21" value="снапшоты фактов&lt;br&gt;(Worker → PostgreSQL)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.1522;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc4" name="D1 Конвейер: все исходы решения"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D1. Конвейер решения: проверки → риск → политика → все исходы" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2615" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; «Конвейер» из всех сценариев, раскрытый: шаги проверки и &lt;b&gt;все исходы решения&lt;/b&gt;. Опора — PDF кейса, с. 14–15: «скоринг ≠ кредитное решение»; итог «не обязательно бинарен… изменить размер или срок финансирования, предложить другой продукт либо запросить дополнительную информацию»; «состав промежуточных этапов зависит от продукта и особенностей клиента».&lt;br&gt;&lt;b&gt;decision.outcome:&lt;/b&gt; APPROVE · COUNTER_OFFER (AMOUNT | TERM | PRODUCT) · APPROVE_WITH_CONDITIONS (GUARANTEE | COLLATERAL) · REQUEST_INFO · MANUAL_REVIEW · REJECT (STOP_FIXABLE | STOP_FINAL | POLICY). Первые три → статус OFFERED (вид оферты — поле, не новый статус), дальше INFO_REQUESTED, UNDER_REVIEW, REJECTED.&lt;br&gt;&lt;b&gt;Одинаковый риск → разные условия по продуктам&lt;/b&gt; (пример политики, наш дизайн; параметры в БД с версией): класс B — овердрафт как просили; экспресс без обеспечения — меньше сумма; инвест-кредит на 5 лет — условно, с залогом и поручительством.&lt;br&gt;&lt;b&gt;Запись решения&lt;/b&gt; (audit): снимок входа, версия политики, класс риска, reason codes, условия. Тот же движок в режиме simulate считает предодобрение и K2/K3, поэтому показанное заранее совпадает с итогом, если не всплыли новые данные.&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; 218-ФЗ ст. 6 ч. 9–10 (согласие); 402-ФЗ ст. 6 ч. 2 п. 1 (ИП может не вести бухучёт → лимит по оборотам); 14-ФЗ ст. 46, 208-ФЗ ст. 78–79, ГК ст. 174 (шаги по клиенту); ГК ст. 334, 361, 363 (обеспечение); КоАП ст. 3.11, 129-ФЗ ст. 7.1 (стоп-факторы). Комитет («второй ключ») — вне скоупа отбора. &lt;b&gt;Алгоритм движка&lt;/b&gt; — E1; &lt;b&gt;сбои источников&lt;/b&gt; — F1 (политики фактов); &lt;b&gt;скоринг&lt;/b&gt; — kb/12_scoring.md: класс риска меняет ставку, лимит и требования к обеспечению." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2615" height="165" as="geometry"/></mxCell><mxCell id="uw" value="Кредитный аналитик&lt;br&gt;&lt;small&gt;UNDER_REVIEW · досье (B1)&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="253" width="2615" height="262" as="geometry"/></mxCell><mxCell id="sys" value="Конвейер&lt;br&gt;&lt;small&gt;Worker + decisioning (commit)&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="2615" height="582" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1097" width="2615" height="70" as="geometry"/></mxCell><mxCell id="s" value="SUBMITTED или ответ на дозапрос" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="547.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="full" value="1. Полнота и согласия&lt;br&gt;&lt;small&gt;поля, документы; согласие на БКИ (218-ФЗ ст. 6 ч. 9–10)&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g1" value="Данных хватает?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="557.5" y="542.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="info1" value="INFO_REQUESTED: чего не хватает → D3" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="562.5" y="627.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="enr" value="2. Обогащение&lt;br&gt;&lt;small&gt;параллельно; таймауты, ретраи, снапшоты&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="steps" value="3. Шаги по продукту и клиенту&lt;br&gt;&lt;small&gt;ИП: обороты · ООО/АО: 25%, устав · поручитель&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;bpmnShapeType=call;taskMarker=abstract;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="stop" value="4. Прямой вывод и стоп-правила (E1)&lt;br&gt;&lt;small&gt;банкротство, дисквалификация, недоимка&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Стоп-фактор?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="1217.5" y="542.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="rej1" value="REJECTED · стоп: устранимый или нет → D4" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1222.5" y="627.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="risk" value="5. Скоринг: балльная карта (12)&lt;br&gt;&lt;small&gt;сегмент → балл → PD → класс A–D&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1337.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="pol" value="6. Таблицы политики и оптимизатор (E1)&lt;br&gt;&lt;small&gt;лимит, срок, продукт, ставка&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1502.5" y="537.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="og" value="Исход&lt;br&gt;&lt;small&gt;decision.outcome&lt;/small&gt;" style="points=[[0