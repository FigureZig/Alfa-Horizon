exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="bki"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_18" value="АБС: выдача" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8663;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc17" name="R8 Один человек в трёх компаниях: бухгалтер"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="R8. Один человек в трёх компаниях: бухгалтер · директор · участник" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1325" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;JTBD:&lt;/b&gt; J-Multi: «не путать компании и права» + J-Acc / J-Dir / J-Own в одной персоне.&lt;br&gt;&lt;b&gt;Сущности (пресет песочницы):&lt;/b&gt; Person «Иванов И.И.»: BankAccess(prepare) в ООО «Альфа-Трейд»; ExecutiveAuthority(independent) в ООО «Северный Хлеб»; Participation 40% в ООО «Склад-Логистик».&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; Совмещение законом не запрещено (ГК ст. 53; 14-ФЗ ст. 40); права считаются отдельно для пары «человек × компания». Массовость — только риск-индикатор (открытый набор ФНС «массовые адреса» не обновляется с 2021).&lt;br&gt;&lt;b&gt;Финалы:&lt;/b&gt; по каждой компании свой: передано на подпись · ISSUED · согласие ОСУ дано.&lt;br&gt;&lt;b&gt;Данные и ручки:&lt;/b&gt; ЕГРЮЛ ×3 (СведДолжнФЛ, СвУчредит) · ДБО банка (доступы) · единый inbox задач." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1325" height="130" as="geometry"/></mxCell><mxCell id="p" value="Иванов И.И.&lt;br&gt;&lt;small&gt;одна персона&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="1325" height="262" as="geometry"/></mxCell><mxCell id="sys" value="Система банка&lt;br&gt;&lt;small&gt;кабинет + конвейер&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1325" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="1325" height="70" as="geometry"/></mxCell><mxCell id="s" value="Вход" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="330.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="calc" value="Пересчёт прав по каждой компании" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=1