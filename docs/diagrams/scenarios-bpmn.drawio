nbox" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_5" value="участник" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inbox" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="aend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="bend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="cend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_11" value="ЕГРЮЛ ×3: СведДолжнФЛ,&lt;br&gt;СвУчредит · ДБО" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2849;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_12" value="АБС: выдача" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.783;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc18" name="R9 Поручитель — связанная компания: сделка "><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="R9. Поручитель — связанная компания: сделка с заинтересованностью" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2315" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;JTBD:&lt;/b&gt; J-Dir + J-Own (незаинтересованные участники поручителя).&lt;br&gt;&lt;b&gt;Сущности (пресет песочницы):&lt;/b&gt; Заёмщик ООО «Северный Хлеб» (директор — Иванов); поручитель ООО «Склад-Логистик», где Иванов — контролирующий участник; у поручителя есть другие участники.&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; &lt;b&gt;14-ФЗ ст. 45 п. 1&lt;/b&gt; (заинтересованность ЕИО или контролирующего лица), &lt;b&gt;п. 3&lt;/b&gt; — известить незаинтересованных участников, &lt;b&gt;п. 4&lt;/b&gt; — обязательного согласия нет, его может потребовать участник с долей ≥ 1%, &lt;b&gt;п. 7&lt;/b&gt; — не применяется, если один участник = ЕИО.&lt;br&gt;&lt;b&gt;Финалы:&lt;/b&gt; ISSUED · ISSUED после согласия · EXPIRED.&lt;br&gt;&lt;b&gt;Данные и ручки:&lt;/b&gt; ЕГРЮЛ ×2: СведДолжнФЛ, СвУчредит/ДоляУстКап (связи) · ГИР БО поручителя · БКИ · АБС.&lt;br&gt;&lt;b&gt;Исходы решения:&lt;/b&gt; после «Конвейера» — развилка D1: оферта (как просили · контрпредложение по сумме, сроку или продукту · условно) → D2; дозапрос → D3; отказ → D4." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2315" height="153" as="geometry"/></mxCell><mxCell id="dir" value="Директор заёмщика&lt;br&gt;&lt;small&gt;он же участник поручителя&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="2315" height="175" as="geometry"/></mxCell><mxCell id="own" value="Незаинтересованные участники поручителя" style="swimlane;horizontal=0;startSize=120;fillColor=#e8f4f8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="2315" height="175" as="geometry"/></mxCell><mxCell id="sys" value="Система банка&lt;br&gt;&lt;small&gt;кабинет + конвейер&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="591" width="2315" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="766" width="2315" height="70" as="geometry"/></mxCell><mxCell id="s" value="Нужен кредит" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="273.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Подать: поручитель «Склад-Логистик»" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="263.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="links" value="Связи лиц между компаниями" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="613.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g1" value="Заинтересованность?&lt;br&gt;&lt;small&gt;ст. 45 п. 1&lt;/small&gt;" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType