решение ОСУ (INFO_REQUESTED)" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="613.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Способ по уставу?&lt;br&gt;&lt;small&gt;ГК 67.1&lt;/small&gt;" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="1217.5" y="443.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="tech" value="Подтвердить согласие в кабинете" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1337.5" y="438.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="notary" value="Нотариус: удостоверить решение" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1337.5" y="518.0" width="140" height="60" as="geome