10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="loan" target="par"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="par" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="par" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="loop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_24" value="Банк: транзакции 12 мес." style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2051;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="k4s"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_25" value="ФНС · юр. проверки ·&lt;br&gt;ЕГРЮЛ (свежие)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.517;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="re"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_26" value="АБС: POST /loans,&lt;br&gt;/disburse" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6418;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="disb" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_27" value="Банк: поступления на р/с" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.8913;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc6" name="D3 Дозапрос и финалы без денег"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D3. Дозапрос; финалы без денег: истекло, отозвано, отказался" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1160" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Дозапрос (INFO_REQUESTED, U5):&lt;/b&gt; банк просит ровно то, чего не хватает, и объясняет зачем: тип (документ, поле, пояснение), срок, кто запросил. Ответ — в кабинете; готовить может бухгалтер (prepare), подпись не нужна. Системный дозапрос → снова конвейер (CHECKING); дозапрос аналитика → снова аналитику (UNDER_REVIEW). Не ответили в срок → EXPIRED. Отозвать заявку можно на любом шаге до выдачи → WITHDRAWN.&lt;br&gt;&lt;b&gt;Финалы без денег&lt;/b&gt; (EXPIRED, WITHDRAWN, DECLINED) терминальны для заявки, но не для клиента: экран итога, затем «подать снова» (клон с данными, без повторного ввода) или «к подбору». Согласие на БКИ не переспрашиваем, пока не истёк год (218-ФЗ ст. 6 ч. 10). Каналы — только кабинет (PDF, «Ограничения», п. 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1160" height="110" as="geometry"/></mxCell><mxCell id="cl" value="Клиент&lt;br&gt;&lt;small&gt;ответ готовит и бухгалтер (prepare)&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="1160" height="342" as="geometry"/></mxCell><mxCell id="sys" value="Система" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1160" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1160" height="70" as="geometry"/></mxCell><mxCell id="s" value="INFO_REQUESTED (из D1)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="230.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="read" value="Понять запрос (U5)&lt;br&gt;&lt;small&gt;что именно, зачем, до какого срока, кто запросил&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="ans" value="Ответить в кабинете&lt;br&gt;&lt;small&gt;документ · поле · пояснение&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="ansx" value="EXPIRED: не ответили в срок" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;labelBackgroundColor=#ffffff;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;outline=end;symbol=general;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;labelWidth=125;" vertex="1" parent="1"><mxGeometry x="562.5" y="310.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="g" value="Кто запросил?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="887.5" y="567.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="back1" value="↺ CHECKING: конвейер продолжает (D1)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="572.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="back2" value="↺ UNDER_REVIEW: снова аналитику (D1)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="652.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="s2" value="EXPIRED · WITHDRAWN · DECLINED" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="390.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="res" value="Экран итога&lt;br&gt;&lt;small&gt;что истекло или отозвано, почему; данные сохранены&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="380.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Что дальше?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="557.5" y="385.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="again" value="↺ подать снова: клон с данными (DRAFT)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="727.5" y="390.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="pick" value="↺ к подбору (U2)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="727.5" y="470.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="ans_b0" value="" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=boundInt;symbol=timer;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="630.5" y="266.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="flow_1" value="срок истёк" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ans_b0" target="ansx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="ans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ans" target="g"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830.0" y="250"/><mxPoint x="830.0" y="592"/></Array></mxGeometry></mxCell><mxCell id="flow_5" value="система" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="back1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="аналитик" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="back2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="подать снова" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="again"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="к подбору" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc7" name="D4 Отказ: путь к одобрению (K3)"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D4. Отказ — не тупик: причины, путь к одобрению (K3), альтернативы" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1160" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Отказ — не тупик&lt;/b&gt; (kb/03_smart.md, K3). Клиент видит понятные причины (reason codes → текст, U8). Слой K3 тем же движком в режиме simulate считает 1–3 действия с эффектом: «погасите недоимку → лимит X», «добавьте поручителя → +Y», «через N мес. стабильных оборотов → экспресс-кредит». Без K3 остаются причины и альтернативы.&lt;br&gt;&lt;b&gt;Устранимые причины:&lt;/b&gt; недоимка, недостоверность сведений в ЕГРЮЛ (129-ФЗ ст. 7.1), дисквалифицированный директор (КоАП ст. 3.11) → исправить → новая заявка-клон. &lt;b&gt;Неустранимые&lt;/b&gt; (банкротство, ликвидация) — честно пишем, что изменить нельзя.&lt;br&gt;&lt;b&gt;Другой продукт:&lt;/b&gt; кредитный (овердрафт — ГК ст. 850, кредитная линия, инвест-кредит) → подбор с подсказкой; лизинг (ГК ст. 665), факторинг (ГК ст. 824), гарантия (44-ФЗ ст. 96) — не кредиты, в MVP только рекомендация (kb/05_legal.md §6). Отказ после перепроверки перед выдачей (ГК ст. 821 п. 1) ведёт сюда же." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1160" height="110" as="geometry"/></mxCell><mxCell id="cl" value="Клиент" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="1160" height="342" as="geometry"/></mxCell><mxCell id="k" value="Доп. слой K" style="swimlane;horizontal=0;startSize=120;fillColor=#f3eef8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1160" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1160" height="70" as="geometry"/></mxCell><mxCell id="s" value="REJECTED (из D1 или перепроверки в D2)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="230.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="why" value="Понять причины (U8)&lt;br&gt;&lt;small&gt;reason codes → текст; что зависит от клиента&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;K3&lt;/b&gt; Путь к одобрению&lt;br&gt;&lt;small&gt;simulate: 1–3 действия, у каждого эффект&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="562.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g" value="Что выберете?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="722.5" y="305.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="fix" value="Исправить причину&lt;br&gt;&lt;small&gt;погасить недоимку, обновить ЕГРЮЛ, сменить директора&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="again" value="↺ подать снова: клон, K3 пересчитал" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="230.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="gp" value="Кредитный продукт?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="887.5" y="305.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="alt" value="↺ подбор (U2): овердрафт, линия, инвест" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="310.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="noncr" value="Лизинг, факторинг, гарантия — не кредит, вне MVP" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="390.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="wait" value="REJECTED: подать после даты; неустранимое — честно" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="892.5" y="470.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="flow_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="why"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="why" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3" target="g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_4" value="исправимо" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="fix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_5" value="другой продукт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="gp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="ждать или неустранимо" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fix" target="again"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gp" target="alt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gp" target="noncr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="снапшоты реестров&lt;br&gt;и данные банка" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.4677;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc8" name="F1 Сбой источника → политика факта"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="F1. Сбой источника: продукт продолжает по политике факта" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2450" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; что делает продукт, когда внешний источник медленный, недоступен, отвечает мусором или противоречит другим (kb/07_resilience.md). Fallback — не только ретраи: решение о поведении заявки записано в базе знаний (политика факта, E1) и покрыто тестами N1–N17.&lt;br&gt;&lt;b&gt;Транспорт:&lt;/b&gt; таймаут на каждый вызов, до 3 ретраев с экспоненциальным backoff и jitter в одном слое, уважение Retry-After, bulkhead на источник; circuit breaker: 5 отказов подряд → OPEN на 30 с (дальше без ожидания таймаутов) → проба. 404 «нет записи» — это ответ, а не сбой; мусор — «источник недоступен», а не «данных нет».&lt;br&gt;&lt;b&gt;Продукт:&lt;/b&gt; кабинет читает снапшоты и работает всегда; подпись и выдача — только на свежих данных; каждый шаг — чекпоинт, воркер упал — шаг продолжается с чекпоинта; источник вернулся — догоняем ожидающие шаги и пересматриваем решения (RECHECK) с диффом клиенту.&lt;br&gt;&lt;b&gt;Как показать:&lt;/b&gt; в песочнице (S0) поставить отказ любого источника на лету — стаб WireMock с priority 1, без перезапуска. &lt;b&gt;787-П&lt;/b&gt;: непрерывность процессов, допустимое время деградации, восстановление, сценарное тестирование — kb/05_legal.md §9." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2450" height="150" as="geometry"/></mxCell><mxCell id="sys" value="Продукт&lt;br&gt;&lt;small&gt;что происходит с заявкой и что видит клиент&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="2450" height="582" as="geometry"/></mxCell><mxCell id="wk" value="Worker&lt;br&gt;&lt;small&gt;integrations: адаптер источника&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#e8f4f8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="2450" height="300" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2450" height="70" as="geometry"/></mxCell><mxCell id="s" value="Шаг конвейера: нужен факт X" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="852.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="g1" value="Снапшот свежий (≤ TTL)?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="392.5" y="847.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="ok1" value="факт KNOWN → дальше (E1)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="562.5" y="852.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="call" value="Вызов ручки&lt;br&gt;&lt;small&gt;таймаут · 3 ретрая с jitter · bulkhead; breaker OPEN → без вызова&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="922.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g2" value="Ответ?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="722.5" y="927.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="save" value="Сохранить снапшот&lt;br&gt;&lt;small&gt;источник, дата, версия контракта&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,