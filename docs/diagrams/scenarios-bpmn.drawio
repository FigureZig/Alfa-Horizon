ll><mxCell id="flow_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="og"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_20" value="иные исходы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="ol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_21" value="ЕГРЮЛ: СвУчредит,&lt;br&gt;ДоляУстКап" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2051;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="rights"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_22" value="ГИР БО:&lt;br&gt;current1600" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2675;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_23" value="Банк: устав&lt;br&gt;(способ решений)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.3922;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="req"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_24" value="ФНС · БКИ" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.7042;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_25" value="АБС: выдача" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8913;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc13" name="R4 Бухгалтер готовит заявку, директор подпи"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="R4. Бухгалтер готовит заявку, директор подписывает" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2150" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;JTBD:&lt;/b&gt; J-Acc: «подготовить всё и отдать на подпись тому, кто вправе» + J-Dir.&lt;br&gt;&lt;b&gt;Сущности (пресет песочницы):&lt;/b&gt; BankAccess(бухгалтер) = prepare; ExecutiveAuthority(директор) = independent. Бухгалтер не указан в ЕГРЮЛ и доверенности не имеет.&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; 14-ФЗ ст. 40 п. 3 пп. 1 (без доверенности — только ЕИО); ГК ст. 185.1 п. 4 (остальные — по доверенности за подписью руководителя). Попытка бухгалтера подписать → отказ с этим объяснением.&lt;br&gt;&lt;b&gt;Финалы:&lt;/b&gt; ISSUED · EXPIRED (директор не подписал в срок).&lt;br&gt;&lt;b&gt;Данные и ручки:&lt;/b&gt; ДБО банка: доступ prepare · ЕГРЮЛ: СведДолжнФЛ · ФНС · ГИР БО · БКИ · АБС.&lt;br&gt;&lt;b&gt;Исходы решения:&lt;/b&gt; после «Конвейера» — развилка D1: оферта (как просили · контрпредложение по сумме, сроку или продукту · условно) → D2; дозапрос → D3; отказ → D4." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2150" height="138" as="geometry"/></mxCell><mxCell id="acc" value="Бухгалтер&lt;br&gt;&lt;small&gt;prepare&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="2150" height="175" as="geometry"/></mxCell><mxCell id="dir" value="Директор&lt;br&gt;&lt;small&gt;sign&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#e8f4f8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="401" width="2150" height="175" as="geometry"/></mxCell><mxCell id="sys" value="Система банка&lt;br&gt;&lt;small&gt;кабинет + конвейер&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="2150" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="751" width="2150" height="70" as="geometry"/></mxCell><mxCell id="s" value="Поручение директора" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="258.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="pick" value="Подобрать продукт" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="248.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="form" value="Заполнить заявку" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="248.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="send" value="Передать на подпись" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=send;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="248.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="rights" value="Права: prepare есть, sign нет" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.