787.5" y="967"/></Array></mxGeometry></mxCell><mxCell id="flow_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="g_t"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1787.5" y="567"/><mxPoint x="1787.5" y="1047"/></Array></mxGeometry></mxCell><mxCell id="flow_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_t" target="a_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_t" target="b_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_t" target="c_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_t" target="d_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_t" target="e_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_t" target="f_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_t" target="g_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_33" value="ЕГРЮЛ/ЕГРИП · ФНС · ГИР БО ·&lt;br&gt;БКИ · юр. проверки · банк" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2706;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="enr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc5" name="D2 Оферта → подпись → выдача"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="D2. Оферта любого вида → подпись → выдача (K3, K4)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2645" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; что клиент делает с офертой любого вида (D1: как просили · контрпредложение по сумме, сроку или продукту · условно) и как деньги доходят до счёта. Экран один; у контрпредложения — сравнение с запрошенным и «почему так» (U6).&lt;br&gt;&lt;b&gt;Выбор клиента:&lt;/b&gt; принять → документы → подпись всеми подписантами (кто — по сущностям, R4–R7; при условной оферте — ещё поручитель или залогодатель, R7) → перепроверка → выдача. «Хочу как просил» → K3: что изменить → клон заявки с изменениями (эта → DECLINED). Отказаться → DECLINED. Не успел → EXPIRED. От получения можно отказаться до выдачи (ГК ст. 821 п. 2).&lt;br&gt;&lt;b&gt;Доп. слой:&lt;/b&gt; K4 — симуляция графика на данных клиента (фиксированный или % от поступлений), после выдачи — списание по договору (ГК ст. 854 п. 2); K3 — на контрпредложении. Без K — фиксированный график, причины и кнопки.&lt;br&gt;&lt;b&gt;Банк:&lt;/b&gt; перед выдачей — перепроверка стоп-факторов по свежим данным; при явном риске невозврата банк вправе отказать (ГК ст. 821 п. 1). Сбой АБС после ретраев → UNDER_REVIEW с флагом (D1). Подпись — ПЭП в ДБО (63-ФЗ ст. 6, 9; ГК ст. 847 п. 4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2645" height="130" as="geometry"/></mxCell><mxCell id="cl" value="Клиент&lt;br&gt;&lt;small&gt;подписанты — по сущностям, R4–R7&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="2645" height="262" as="geometry"/></mxCell><mxCell id="sys" value="Система&lt;br&gt;&lt;small&gt;signing · applications · loans&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="2645" height="175" as="geometry"/></mxCell><mxCell id="k" value="Доп. слой K" style="swimlane;horizontal=0;startSize=120;fillColor=#f3eef8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="2645" height="262" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="917" width="2645" height="70" as="geometry"/></mxCell><mxCell id="s" value="OFFERED (из D1)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="250.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="view" value="Изучить оферту (U6)&lt;br&gt;&lt;small&gt;условия, график, «почему так»; сравнение с запрошенным&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="240.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="viewx" value="EXPIRED: срок оферты истёк" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="397.5" y="330.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k4s" value="&lt;b&gt;K4&lt;/b&gt; График: фикс. или % от поступлений&lt;br&gt;&lt;small&gt;симуляция на данных за 12 мес.&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="677.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="cg" value="Решение по оферте" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="722.5" y="325.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="decl" value="DECLINED → к подбору" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="892.5" y="250.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="acc" value="Принять оферту&lt;br&gt;&lt;small&gt;с выбранным графиком&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="320.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3b" value="&lt;b&gt;K3&lt;/b&gt; Что изменить, чтобы дали как просили&lt;br&gt;&lt;small&gt;«добавьте поручителя → +X»&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="757.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k3bx" value="↺ клон в DRAFT с изменениями (эта → DECLINED)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="767.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="docs" value="Сформировать документы (signing)&lt;br&gt;&lt;small&gt;договор; если условно — поручительство, залог&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="502.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="sign" value="Подписать (ПЭП) всеми подписантами&lt;br&gt;&lt;small&gt;поручитель — лично (R7)&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1172.5" y="320.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="signx" value="EXPIRED: не все подписали" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1222.5" y="410.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="wd" value="WITHDRAWN: отказ от получения (ГК 821 п. 2)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1387.5" y="250.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="re" value="Перепроверка стоп-факторов&lt;br&gt;&lt;small&gt;свежие данные; ГК 821 п. 1&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=m