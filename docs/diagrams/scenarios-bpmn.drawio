=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="expl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="участников &gt; 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="expl" target="conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="оферта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="offer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="offer" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="og"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_12" value="иные исходы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="ol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_13" value="ЕГРЮЛ: СведДолжнФЛ,&lt;br&gt;ВидПолном, СвУчредит" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.2733;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="rights"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_14" value="ГИР БО:&lt;br&gt;balance.current1600" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.3564;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_15" value="ФНС · БКИ ·&lt;br&gt;реестр дисквал." style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.6058;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_16" value="АБС: выдача" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8552;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc12" name="R3 ООО: крупная сделка → согласие общего со"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="R3. ООО: крупная сделка → согласие общего собрания участников (вкл. R3b)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2645" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;JTBD:&lt;/b&gt; J-Dir + J-Own: «понять, на что соглашаюсь как участник, и решить».&lt;br&gt;&lt;b&gt;Сущности (пресет песочницы):&lt;/b&gt; 3 участника (ЕГРЮЛ СвУчредит), директор — не единственный участник; ГИР БО current1600 = 20 000 тыс. ₽; кредит 6 млн ₽; CharterLimit.method = notary | tech_means.&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; 14-ФЗ ст. 46 п. 1, 3, 4 (согласие — ОСУ; без него сделка оспорима, ГК ст. 173.1); &lt;b&gt;ГК ст. 67.1 п. 3 пп. 3&lt;/b&gt; — решение удостоверяется нотариально, если устав не допускает иной способ (протокол, технические средства).&lt;br&gt;&lt;b&gt;Финалы:&lt;/b&gt; ISSUED · REJECTED (ОСУ против) · EXPIRED (решение не принесли в срок).&lt;br&gt;&lt;b&gt;Данные и ручки:&lt;/b&gt; ЕГРЮЛ: СвУчредит, ДоляУстКап/Процент · ГИР БО: current1600 · Банк: устав (способ удостоверения) · ФНС · БКИ.&lt;br&gt;&lt;b&gt;Исходы решения:&lt;/b&gt; после «Конвейера» — развилка D1: оферта (как просили · контрпредложение по сумме, сроку или продукту · условно) → D2; дозапрос → D3; отказ → D4." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2645" height="153" as="geometry"/></mxCell><mxCell id="dir" value="Директор (ЕИО)" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="2645" height="175" as="geometry"/></mxCell><mxCell id="own" value="Участники ООО&lt;br&gt;&lt;small&gt;ОСУ&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#e8f4f8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="2645" height="175" as="geometry"/></mxCell><mxCell id="sys" value="Система банка&lt;br&gt;&lt;small&gt;кабинет + конвейер&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="591" width="2645" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="766" width="2645" height="70" as="geometry"/></mxCell><mxCell id="s" value="Нужен кредит 6 млн" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="273.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="s