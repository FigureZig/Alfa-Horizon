<mxfile host="AlphaHack"><diagram id="sc0" name="Легенда"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Как читать BPMN-доску" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1820" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; схемы «как в идеале», ground truth — kb/README.md. &lt;b&gt;K0&lt;/b&gt; — сквозной путь умного кабинета: основа + доп. слой K; &lt;b&gt;S0&lt;/b&gt; — демо-этап «Кто я»; &lt;b&gt;E1&lt;/b&gt; — экспертная система движка; &lt;b&gt;D1&lt;/b&gt; — конвейер и все исходы решения; &lt;b&gt;D2–D4&lt;/b&gt; — что клиент делает с офертой, дозапросом и отказом; &lt;b&gt;F1–F2&lt;/b&gt; — сбой источника и выдача ровно один раз; &lt;b&gt;R1–R13&lt;/b&gt; — ролевые сценарии (kb/02_product.md §8, kb/05_legal.md).&lt;br&gt;&lt;b&gt;Дорожки&lt;/b&gt; — участники (права вычислены из сущностей реестров). Нижний блок — реестры и системы банка: в демо моки WireMock, ручки и поля — kb/09. &lt;b&gt;Фиолетовое&lt;/b&gt; — доп. слой K (kb/03_smart.md): за фича-флагами, выключение не рвёт путь.&lt;br&gt;&lt;b&gt;Пунктир с кружком&lt;/b&gt; — message flow: какие данные откуда приходят (поля — как в спецификациях ФНС, ЦБ, ГИР БО).&lt;br&gt;&lt;b&gt;Таймер на задаче&lt;/b&gt; — срок ожидания; истёк → EXPIRED. &lt;b&gt;Ромб&lt;/b&gt; — развилка, рядом норма. &lt;b&gt;Ссылка (↺, →)&lt;/b&gt; — переход на другую страницу или возврат в путь.&lt;br&gt;После «Конвейера» везде стоит развилка &lt;b&gt;«Исход (D1)»&lt;/b&gt;: на схеме сценария — ветка оферты, остальные исходы — ссылкой на D3/D4. &lt;b&gt;Скоринг и рейтинг&lt;/b&gt; — отдельная проработка (порт RiskModel)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1820" height="150" as="geometry"/></mxCell><mxCell id="u" value="Участник (человек)" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="1820" height="175" as="geometry"/></mxCell><mxCell id="sys" value="Система банка&lt;br&gt;&lt;small&gt;кабинет + конвейер&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="413" width="1820" height="175" as="geometry"/></mxCell><mxCell id="k" value="Доп. слой K" style="swimlane;horizontal=0;startSize=120;fillColor=#f3eef8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="1820" height="175" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="763" width="1820" height="70" as="geometry"/></mxCell><mxCell id="s" value="Старт" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=general;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="270.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="t" value="Действие человека" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="260.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="snd" value="Отправить задачу другому" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=send;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="260.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="sv" value="Действие системы" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="435.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="g" value="Развилка&lt;br&gt;&lt;small&gt;норма&lt;/small&gt;" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="887.5" y="440.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="lnk" value="→ другой сценарий" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="525.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="c" value="Конвейер → D1" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;bpmnShapeType=call;taskMarker=abstract;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="435.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="og" value="Исход&lt;br&gt;&lt;small&gt;D1&lt;/small&gt;" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="1217.5" y="440.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="ol" value="дозапрос → D3&lt;br&gt;отказ → D4" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;labelBackgroundColor=#ffffff;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;outline=end;symbol=link;fontSize=10;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;labelWidth=110;" vertex="1" parent="1"><mxGeometry x="1222.5" y="525.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="w" value="Ждём действие" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1337.5" y="260.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="exp" value="EXPIRED" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1387.5" y="350.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="ok" value="Успех (ISSUED)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=terminate;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1552.5" y="270.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="bad" value="Отказ (REJECTED)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1717.5" y="270.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="ks" value="Триггер K (время, событие)" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=timer;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="232.5" y="620.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="kt" value="Шаг слоя K&lt;br&gt;&lt;small&gt;за фича-флагом&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="347.5" y="610.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="kl" value="↺ возврат в основной путь" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=link;fontSize=10;" vertex="1" parent="1"><mxGeometry x="562.5" y="620.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="w_b0" value="" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=boundInt;symbol=timer;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455.5" y="306.0" width="28" height="28" as="geometry"/></mxCell><mxCell id="flow_1" value="срок истёк" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w_b0" target="exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t" target="snd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="snd" target="sv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sv" target="g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_6" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_7" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g" target="lnk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="og"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_9" value="оферта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_10" value="иные исходы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="og" target="ol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ks" target="kt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=default;strokeColor=#9673a6;fontColor=#5b3f6e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kt" target="kl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow_14" value="Реестр: поле" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=oval;startFill=0;strokeColor=#6c6c6c;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;align=center;exitX=0.3887;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="sv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sc1" name="K0 Умный кабинет: путь + слой K"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="K0. Умный кабинет: сквозной путь — основа + доп. слой K" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2810" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Что это:&lt;/b&gt; весь путь «умного кабинета» на одной схеме. &lt;b&gt;Основа&lt;/b&gt; (синее) — обязательный по кейсу путь: потребность → подбор → заявка → конвейер → оферта → подпись → выдача; она закрыта сама. &lt;b&gt;Доп. слой K&lt;/b&gt; (фиолетовое, нижняя дорожка) — пять точек расширения из kb/03_smart.md, каждая за фича-флагом FEATURE_K1…K5: выключили — фиолетовые шаги пропускаются, путь не рвётся (тест «основа зелёная при выключенных K»). Новых статусов K не создают.&lt;br&gt;&lt;b&gt;Где K встраивается:&lt;/b&gt; K1 радар разрыва и K5 сигнал о контракте → K2 предрешённый оффер — второй вход в ту же заявку (DRAFT уже заполнен, решение посчитано в режиме simulate); K3 — на отказе и на контрпредложении: действие → эффект → клон заявки; K4 — график из поступлений: выбор на оферте, списание после выдачи; после выдачи K1 следит дальше → новый цикл.&lt;br&gt;&lt;b&gt;Исходы решения не бинарны&lt;/b&gt; (PDF кейса, с. 15): оферта (как просили · контрпредложение по сумме, сроку или продукту · условно, с обеспечением), дозапрос, отказ. Как банк решает — &lt;b&gt;D1&lt;/b&gt;; что делает клиент — &lt;b&gt;D2&lt;/b&gt; (оферта), &lt;b&gt;D3&lt;/b&gt; (дозапрос, финалы без денег), &lt;b&gt;D4&lt;/b&gt; (отказ).&lt;br&gt;&lt;b&gt;Нормы:&lt;/b&gt; ГК ст. 850 (овердрафт), 854 п. 2 (списание по договору — K4), 821 п. 1–2 (перепроверка перед выдачей; отказ заёмщика от получения); 218-ФЗ ст. 6 ч. 9–10 (согласие на БКИ, для МСП 1 год), ч. 9.1 (информационная часть без согласия — предодобрение); 63-ФЗ ст. 6, 9 (ПЭП в ДБО). Календарь K1: НДС, взносы, НДФЛ — 28-го (НДФЛ ещё и 5-го): НК ст. 174 п. 1, 431 п. 3, 226 п. 6; зарплата — не реже чем каждые полмесяца (ТК ст. 136 ч. 6). K5: оплата по контракту — до 7 раб. дней после приёмки (44-ФЗ ст. 34 ч. 13.1).&lt;br&gt;&lt;b&gt;Данные:&lt;/b&gt; транзакции за 12 мес. (банк), контракты ЕИС, реестры для конвейера — kb/09. Внешние ручки вызывает только Worker, слой K читает снапшоты. &lt;b&gt;Перед K0&lt;/b&gt; — демо-этап «Кто я» (S0); &lt;b&gt;сбой любого источника&lt;/b&gt; — по политике факта (F1), заявка не теряется." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2810" height="188" as="geometry"/></mxCell><mxCell id="stage_hdr" value="&lt;b&gt;Этап&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#e0e0e0;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="130" height="30" as="geometry"/></mxCell><mxCell id="stage0" value="&lt;b&gt;0. Вход&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#ececec;" vertex="1" parent="1"><mxGeometry x="170" y="276" width="165" height="30" as="geometry"/></mxCell><mxCell id="stage1" value="&lt;b&gt;1. Потребность&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="335" y="276" width="660" height="30" as="geometry"/></mxCell><mxCell id="stage2" value="&lt;b&gt;2. Заявка&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#ececec;" vertex="1" parent="1"><mxGeometry x="995" y="276" width="330" height="30" as="geometry"/></mxCell><mxCell id="stage3" value="&lt;b&gt;3. Проверка и решение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="1325" y="276" width="330" height="30" as="geometry"/></mxCell><mxCell id="stage4" value="&lt;b&gt;4. Ответ клиента: оферта, дозапрос, отказ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#ececec;" vertex="1" parent="1"><mxGeometry x="1655" y="276" width="495" height="30" as="geometry"/></mxCell><mxCell id="stage5" value="&lt;b&gt;5. Выдача&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#f7f7f7;" vertex="1" parent="1"><mxGeometry x="2150" y="276" width="330" height="30" as="geometry"/></mxCell><mxCell id="stage6" value="&lt;b&gt;6. После выдачи — вне базы (доп. слой)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#bdbdbd;fontColor=#333333;fillColor=#ececec;" vertex="1" parent="1"><mxGeometry x="2480" y="276" width="330" height="30" as="geometry"/></mxCell><mxCell id="cl" value="Клиент&lt;br&gt;&lt;small&gt;лицо с правом подписи; кто именно — R1–R13&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f5f5f5;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="2810" height="262" as="geometry"/></mxCell><mxCell id="sys" value="Основа&lt;br&gt;&lt;small&gt;кабинет + конвейер банка&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#eef3fb;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="2810" height="175" as="geometry"/></mxCell><mxCell id="k" value="Доп. слой K&lt;br&gt;&lt;small&gt;insights · фича-флаги&lt;/small&gt;" style="swimlane;horizontal=0;startSize=120;fillColor=#f3eef8;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="749" width="2810" height="262" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Реестры и системы банка&lt;/b&gt; — в демо моки WireMock (ручки и поля: kb/09_data_contracts.md; отказы на лету: kb/07_resilience.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efedf3;strokeColor=#736782;fontColor=#3b3346;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1011" width="2810" height="70" as="geometry"/></mxCell><mxCell id="pick" value="Подбор: цель → сумма и срок&lt;br&gt;&lt;small&gt;U2&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="334.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="prod" value="Выбрать продукт&lt;br&gt;&lt;small&gt;метки U1: предодобрено / нужно рассмотрение / недоступно — почему&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="677.5" y="334.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k1s" value="Ежедневно: новые операции по счёту" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=standard;symbol=timer;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="397.5" y="781.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;K1&lt;/b&gt; Радар: прогноз остатка на 30 дн.&lt;br&gt;&lt;small&gt;поступления − списания − налоги − ЗП&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512.5" y="771.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k1g" value="Разрыв в 30 дн.?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;whiteSpace=wrap;gwType=exclusive;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelWidth=120;" vertex="1" parent="1"><mxGeometry x="722.5" y="776.0" width="50" height="50" as="geometry"/></mxCell><mxCell id="k1n" value="Разрыва нет:&lt;br&gt;кредит не навязываем" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;labelBackgroundColor=#ffffff;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;outline=end;symbol=general;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;labelWidth=270;" vertex="1" parent="1"><mxGeometry x="727.5" y="861.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k5s" value="ЕИС: новый контракт, клиент — поставщик" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;labelBackgroundColor=#ffffff;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;outline=standard;symbol=message;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;labelWidth=125;" vertex="1" parent="1"><mxGeometry x="727.5" y="941.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;K5&lt;/b&gt; Сигнал «контракт»&lt;br&gt;&lt;small&gt;цена, срок, аванс&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="931.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;K2&lt;/b&gt; Предрешённый оффер&lt;br&gt;&lt;small&gt;simulate: продукт, сумма, срок; действует N дней&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=service;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="842.5" y="771.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k2c" value="«Банк заметил»: подтвердить оффер в 1 клик" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1007.5" y="414.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="k2x" value="Оффер истёк — заявки не было" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;labelWidth=130;outline=end;symbol=general;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1057.5" y="504.0" width="40" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Проверить заявку, согласие на БКИ, подать (ПЭП)&lt;br&gt;&lt;small&gt;DRAFT предзаполнен (U3)&lt;/small&gt;" style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=user;fillColor=#dae8