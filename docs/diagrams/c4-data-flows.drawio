<mxfile host="AlphaHack"><diagram id="c4data" name="C4 L2 + потоки данных"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4, уровень 2: контейнеры и потоки данных (что откуда приходит и через какие ручки)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1800" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Для чего:&lt;/b&gt; видеть все зависимости системы от внешнего мира: какой контейнер что вызывает, какие поля откуда берём и в какие сущности (kb/04, kb/05) они превращаются.&lt;br&gt;&lt;b&gt;Правило архитектуры:&lt;/b&gt; внешние системы вызывает &lt;b&gt;только Worker&lt;/b&gt; (модуль integrations: таймауты, ретраи, кэш). API читает &lt;b&gt;снапшоты&lt;/b&gt; реестров из PostgreSQL и сам наружу не ходит, поэтому интерфейс не зависит от доступности реестров.&lt;br&gt;&lt;b&gt;Поля&lt;/b&gt; названы как в реальных спецификациях: ЕГРЮЛ — формат ФНС 4.06; ФНС — XSD открытых данных; ГИР БО — JSON сайта; БКИ — формат ЦБ «Кредитный отчёт» v3.4. Полный каталог ручек и примеры ответов — &lt;b&gt;kb/09_data_contracts.md&lt;/b&gt;; отказы и fallback — &lt;b&gt;kb/07_resilience.md&lt;/b&gt; и страница L3-W.&lt;br&gt;&lt;b&gt;Скоринг и рейтинг&lt;/b&gt; — отдельная проработка (порт decisioning.RiskModel), здесь не раскрыты. &lt;b&gt;Страница 2 (L3)&lt;/b&gt; — модули API: как доп. слой K подключён к основе, исходы решения, топики." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2400" height="112" as="geometry"/></mxCell><mxCell id="p_client" value="&lt;b style='font-size:13px'&gt;Клиент МСБ&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;директор, бухгалтер, представитель, участник" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="230" y="210" width="200" height="180" as="geometry"/></mxCell><mxCell id="p_uw" value="&lt;b style='font-size:13px'&gt;Кредитный аналитик&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;ручное рассмотрение" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="200" height="180" as="geometry"/></mxCell><mxCell id="p_demo" value="&lt;b style='font-size:13px'&gt;Проверяющий (демо)&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;песочница /sandbox" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="1050" y="210" width="200" height="180" as="geometry"/></mxCell><mxCell id="bnd" value="Умный кредитный кабинет [docker compose]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="140" y="450" width="1440" height="880" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style='font-size:14px'&gt;Web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[nginx + Vue 3 SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;зоны: клиент, банк (аналитик), песочница (только DEMO_MODE); reverse proxy /api" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;strokeColor=#118ACD;fillColor=#23A2D9;strokeWidth=1;fontColor=#ffffff;fontSize=11;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="420" height="150" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style='font-size:14px'&gt;API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Python 3.13, FastAPI · модульный монолит]&lt;/span&gt;&lt;br&gt;&lt;br&gt;parties (права из сущностей) · applications (state machine) · decisioning (simulate/commit → decision.outcome: оферта как просили, контрпредложение, условно · дозапрос · ручное · отказ) · insights (доп. слой K1–K5, флаги) · tasks/inbox · signing (ПЭП) · loans · audit · sandbox (DEMO_MODE)&lt;br&gt;REST /api/v1 (OpenAPI 3.1) + SSE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="700" width="520" height="220" as="geometry"/></mxCell><mxCell id="wrk" value="&lt;b style='font-size:14px'&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[тот же пакет, отдельный процесс]&lt;/span&gt;&lt;br&gt;&lt;br&gt;integrations: адаптеры ко всем внешним ручкам, таймауты, ретраи, кэш/TTL · шаги конвейера · таймеры (EXPIRED) · обновление снапшотов реестров по событию registry.changed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="700" width="520" height="220" as="geometry"/></mxCell><mxCell id="db" value="&lt;b style='font-size:14px'&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[БД]&lt;/span&gt;&lt;br&gt;&lt;br&gt;5 таблиц: applications (заявка целиком, JSONB) · events (история, аудит; NOTIFY → SSE) · jobs (очередь, таймеры, SKIP LOCKED) · snapshots (ответы реестров с датой) · kv (breaker, демо)" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="770" y="1020" width="420" height="230" as="geometry"/></mxCell><mxCell id="x_egrul" value="&lt;b style='font-size:12px'&gt;ЕГРЮЛ / ЕГРИП&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · формат ФНС 4.06]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /egrul/v1/legal-entities/{inn} · GET /egrip/v1/entrepreneurs/{inn}&lt;/span&gt;&lt;br&gt;СвЮЛ(ИНН, ОГРН, КодОПФ, ПолнНаимОПФ) · СвСтатус · СвОКВЭДОсн · СведДолжнФЛ(СвФЛ, СвДолжн, СвНедДанДолжнФЛ, СвДискв) · СвПолном/ВидПолном · СвУчредит(УчрФЛ, УчрЮЛРос, ДоляУстКап/РазмерДоли/Процент)&lt;br&gt;&lt;i&gt;→ Company, ExecutiveAuthority, Participation, RegistryFlag&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="200" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_egrul" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_egrul"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_fns" value="&lt;b style='font-size:12px'&gt;ФНС: открытые данные&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · XSD наборов ФНС]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /fns/v1/{rsmp|sshr|paytax|debtam|snr}/{inn}&lt;/span&gt;&lt;br&gt;ОргВклМСП/ИПВклМСП(КатСубМСП) · СведССЧР/КолРаб · СвУплСумНал(НаимНалог, СумУплНал) · СведНедоим(СумНедНалог, СумПени, СумШтраф, ОбщСумНедоим) · СведСНР(ПризнУСН, ПризнЕСХН, ПризнАУСН)&lt;br&gt;&lt;i&gt;→ Company.mspCategory, TaxProfile, TaxDebt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="312" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_fns" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.173;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_fns"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_rdl" value="&lt;b style='font-size:12px'&gt;ФНС: реестр дисквалифицированных лиц&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · CSV-структура ФНС]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /fns/v1/disqualified?inn=&amp;amp;fio=&lt;/span&gt;&lt;br&gt;G1 дата рождения · G4 ИНН организации · G5 должность · G6 статья КоАП · G10 срок · G11 дата начала&lt;br&gt;&lt;i&gt;→ Disqualification&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="424" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_rdl" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.267;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_rdl"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_girbo" value="&lt;b style='font-size:12px'&gt;ГИР БО (бухотчётность)&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · JSON bo.nalog.gov.ru]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /girbo/v1/organizations/search?query={inn} · GET /girbo/v1/organizations/{id}/bfo&lt;/span&gt;&lt;br&gt;period · actualBfoDate · balance.current1600 (итог актива) · current1300 · current1500 · financialResult.current2110 (выручка) · current2400&lt;br&gt;&lt;i&gt;→ FinancialStatement (порог 25% — L1)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="536" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_girbo" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.36;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_girbo"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_bki" value="&lt;b style='font-size:12px'&gt;БКИ&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · формат ЦБ «Кредитный отчёт» v3.4]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;POST /bki/v1/credit-reports · POST /bki/v1/info-part (без согласия, ч. 9.1)&lt;/span&gt;&lt;br&gt;Subject(Identity, Bankruptcy) · Credits/Credit(Amount, CurrentLimit, PrincipalDebt, OverdueAmount, PastDepthOfDelayInDay, AvgMonthPaymentSum, TwoPaymentsSkipped) · OtherJudgements · RequestsStatistic/NumberOfRequests&lt;br&gt;&lt;i&gt;→ CreditHistory (только после Consent)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="648" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_bki" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.453;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_bki"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_mchd" value="&lt;b style='font-size:12px'&gt;Реестр МЧД (ФНС)&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · по m4d.nalog.gov.ru]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /mchd/v1/poa/{guid} · GET /mchd/v1/poa?principalInn=&amp;amp;representativeSnils=&lt;/span&gt;&lt;br&gt;guid · status: ACTIVE | EXPIRED | REVOKED | SUSPENDED · principal(inn, ogrn) · representative(snils, inn, fio) · powers[](code — Классификатор полномочий ЕСНСИ, name) · validFrom · validTo&lt;br&gt;&lt;i&gt;→ PowerOfAttorney&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="760" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_mchd" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.547;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_mchd"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_legal" value="&lt;b style='font-size:12px'&gt;Юр. проверки&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · сокращённый контракт]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /legal-checks/v1/{inn}&lt;/span&gt;&lt;br&gt;bankruptcy(stage, efrsbDate) · arbitration(asDefendantCount, claimsSum) · enforcement(count, sum) · sanctionsListHit&lt;br&gt;&lt;i&gt;→ RegistryFlag (стоп-факторы)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="872" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_legal" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.64;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_legal"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_core" value="&lt;b style='font-size:12px'&gt;Банк: ядро (KYC, ДБО, счета, устав)&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · внутренний контракт]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /bank-core/v1/persons/{id} · /companies/{inn}/access · /companies/{inn}/charter · /accounts/{inn}/transactions&lt;/span&gt;&lt;br&gt;KYC (идентифицирован) · доступы ДБО (view | prepare) · устав: лимиты, способ удостоверения решений ОСУ · транзакции 12 мес. (дата, сумма, приход/расход, контрагент, категория)&lt;br&gt;&lt;i&gt;→ Person, BankAccess, CharterLimit, Turnover (U1 предодобрение, K1, K2, K4)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="984" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_core" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.733;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_core"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_abs" value="&lt;b style='font-size:12px'&gt;АБС (выдача)&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · внутренний контракт, Idempotency-Key]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;POST /abs/v1/loans · POST /abs/v1/loans/{id}/disburse&lt;/span&gt;&lt;br&gt;loanAccount · status: OPENED | DISBURSED | FAILED · schedule[]&lt;br&gt;&lt;i&gt;→ Loan&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="1096" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_abs" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.827;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_abs"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_eis" value="&lt;b style='font-size:12px'&gt;ЕИС закупки (K5)&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок · сокращённый контракт]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;GET /eis/v1/contracts?supplierInn=&lt;/span&gt;&lt;br&gt;regNum · customer · price · signDate · endDate · advancePercent · treasurySupport&lt;br&gt;&lt;i&gt;→ Signal TENDER_WON (доп. слой K)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="1208" width="760" height="100" as="geometry"/></mxCell><mxCell id="w_x_eis" value="" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="x_eis"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_wm" value="&lt;b style='font-size:12px'&gt;WireMock admin API&lt;/b&gt; &lt;span style='font-size:10px'&gt;[только DEMO_MODE]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;POST /__admin/mappings · POST /__admin/scenarios/reset&lt;/span&gt;&lt;br&gt;песочница меняет «реестры» (директор, МЧД, доли, флаги) → событие registry.changed → Worker обновляет снапшот → пересчёт прав&lt;br&gt;&lt;i&gt;→ демо-управление внешним миром&lt;/i&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="1340" width="760" height="100" as="geometry"/></mxCell><mxCell id="x_llm" value="&lt;b style='font-size:14px'&gt;LLM (опционально)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[Ollama / OpenAI-compatible, вне Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;POST /v1/chat/completions · не в пути решения" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="1400" width="360" height="120" as="geometry"/></mxCell><mxCell id="r1" value="HTTPS" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_client" target="web"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="HTTPS" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_uw" target="web"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3" value="HTTPS · /sandbox" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_demo" target="web"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4" value="REST /api/v1 · SSE" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="api"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="SQL: заявки, события, задачи, снапшоты" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="db"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r6" value="SKIP LOCKED · снапшоты · NOTIFY" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk" target="db"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r7" value="sandbox → «реестры» (DEMO_MODE)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="x_wm"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="909"/><mxPoint x="745" y="1300"/><mxPoint x="1620" y="1300"/><mxPoint x="1620" y="1390"/></Array></mxGeometry></mxCell><mxCell id="r8" value="опционально (K / финал)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="x_llm"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Легенда:&lt;/b&gt; синие — наши контейнеры; серые — внешние системы (в демо — моки WireMock с полями по реальным спецификациям); пунктир — только демо или опционально. Стрелки из Worker — вызовы ручек, ответы превращаются в сущности (курсив). Скоринг и рейтинг — отдельная работа." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1400" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c4l3" name="C4 L3: модули API + слой K"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4, уровень 3: модули API — основа и доп. слой K, исходы решения, топики" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1800" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Для чего:&lt;/b&gt; видеть, как «умный слой» K (kb/03_smart.md) подключён к основе и откуда берёт данные; какие исходы даёт движок решения и какие события ходят между модулями. BPMN-путь — scenarios-bpmn.drawio: K0 (путь + слой K), D1 (исходы решения), D2–D4 (действия клиента).&lt;br&gt;&lt;b&gt;Правило зависимостей:&lt;/b&gt; только вверх — insights → основа (decisioning.simulate, applications.api, loans.api). Основа → insights запрещено (контракт import-linter); каждый K за фича-флагом FEATURE_K1…K5, выключили — основа работает. Новых статусов K не создают.&lt;br&gt;&lt;b&gt;Один движок, два режима:&lt;/b&gt; simulate (предодобрение U1, оффер K2, «что если» K3) и commit (решение по заявке). Поэтому показанное заранее совпадает с итогом, если не всплыли новые данные. Остальные модули основы (parties, tasks, signing, audit, sandbox) — architecture.c4 и страница L2." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2140" height="112" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style='font-size:14px'&gt;Web&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[nginx + Vue 3 SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;экраны: главная («Банк заметил»), подбор, заявка, оферта, дозапрос, отказ" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;strokeColor=#118ACD;fillColor=#23A2D9;strokeWidth=1;fontColor=#ffffff;fontSize=11;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="420" height="120" as="geometry"/></mxCell><mxCell id="catalog" value="&lt;b style='font-size:14px'&gt;catalog&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;продукты, версии политики, ключевая ставка (M1), отраслевые спреды (M4)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="200" width="300" height="120" as="geometry"/></mxCell><mxCell id="bnd_api" value="API [FastAPI, модульный монолит]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=right;verticalAlign=bottom;spacing=10;dashPattern=8 4;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1640" height="520" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b style='font-size:14px'&gt;applications&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент · state machine]&lt;/span&gt;&lt;br&gt;&lt;br&gt;DRAFT → … → OFFERED (вид оферты) · INFO_REQUESTED · UNDER_REVIEW · REJECTED · DECLINED · EXPIRED · WITHDRAWN · ISSUED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="380" width="400" height="140" as="geometry"/></mxCell><mxCell id="dec" value="&lt;b style='font-size:14px'&gt;decisioning&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент · simulate | commit]&lt;/span&gt;&lt;br&gt;&lt;br&gt;стоп-факторы → RiskModel (порт) → политика → decision.outcome + reason codes + версия политики" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="440" height="140" as="geometry"/></mxCell><mxCell id="loans" value="&lt;b style='font-size:14px'&gt;loans&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;кредит после выдачи: график, остаток, платежи" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1300" y="380" width="280" height="140" as="geometry"/></mxCell><mxCell id="bnd_k" value="Доп. слой K — insights [фича-флаги FEATURE_K1…K5]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#9673a6;fontColor=#5b3f6e;labelBackgroundColor=none;align=left;verticalAlign=top;spacing=10;dashPattern=8 4;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1600" height="250" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b style='font-size:14px'&gt;forecast · K1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;прогноз остатка на 30 дн.: поступления, списания, календарь (налоги 28-го, ЗП)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#9673a6;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#6a4c7d;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="260" height="140" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b style='font-size:14px'&gt;signals · K1, K5&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;правила → сигналы CASH_GAP, TENDER_WON" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#9673a6;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#6a4c7d;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="240" height="140" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b style='font-size:14px'&gt;offers · K2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;сигнал + simulate → оффер со сроком; «Закрыть разрыв» → DRAFT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#9673a6;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#6a4c7d;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="630" y="640" width="260" height="140" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b style='font-size:14px'&gt;advisor · K3&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;путь к одобрению: действие → эффект; «подать с изменениями» → клон заявки через applications.api" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#9673a6;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#6a4c7d;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b style='font-size:14px'&gt;repayment · K4&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;график: фикс. или % от поступлений (ГК 854 п. 2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#9673a6;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#6a4c7d;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="640" width="260" height="140" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b style='font-size:14px'&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[БД]&lt;/span&gt;&lt;br&gt;&lt;br&gt;snapshots: транзакции 12 мес., контракты ЕИС, реестры · events: application.status_changed · decision.made {outcome, offerKind, counter[], conditions[], reasons[], policyVersion} · insight.signal {CASH_GAP | TENDER_WON, date, amount} · registry.changed · jobs: шаги, таймеры, выдача · applications.data: оферта, варианты, кредит" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1080" height="200" as="geometry"/></mxCell><mxCell id="wrk2" value="&lt;b style='font-size:14px'&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[тот же пакет, отдельный процесс]&lt;/span&gt;&lt;br&gt;&lt;br&gt;единственный, кто вызывает внешние ручки; кладёт снапшоты и события в БД; таймеры" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="930" width="440" height="150" as="geometry"/></mxCell><mxCell id="ext2" value="&lt;b&gt;Внешние ручки (моки WireMock)&lt;/b&gt;&lt;br&gt;банк: транзакции, поступления · ЕИС: контракты · ЕГРЮЛ, ФНС, ГИР БО, БКИ, МЧД, юр. проверки, АБС — поля и ручки на странице L2 и в kb/09" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1720" y="930" width="460" height="150" as="geometry"/></mxCell><mxCell id="outcomes" value="&lt;b&gt;decision.outcome → статус → экран клиента&lt;/b&gt;&lt;br&gt;&lt;table style='font-size:11px;border-collapse:collapse' cellpadding='3' border='1'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;APPROVE&lt;/b&gt;&lt;/td&gt;&lt;td&gt;OFFERED · как просили&lt;/td&gt;&lt;td&gt;оферта → D2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;COUNTER_OFFER&lt;/b&gt;&lt;br&gt;AMOUNT · TERM · PRODUCT&lt;/td&gt;&lt;td&gt;OFFERED · контрпредложение&lt;/td&gt;&lt;td&gt;сравнение с запрошенным, K3 → D2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;APPROVE_WITH_CONDITIONS&lt;/b&gt;&lt;br&gt;GUARANTEE · COLLATERAL&lt;/td&gt;&lt;td&gt;OFFERED · условно&lt;/td&gt;&lt;td&gt;задачи поручителю → D2, R7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;REQUEST_INFO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INFO_REQUESTED&lt;/td&gt;&lt;td&gt;точечный дозапрос → D3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;MANUAL_REVIEW&lt;/b&gt;&lt;/td&gt;&lt;td&gt;UNDER_REVIEW&lt;/td&gt;&lt;td&gt;«у специалиста», SLA → D1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;REJECT&lt;/b&gt;&lt;br&gt;STOP_FIXABLE · STOP_FINAL · POLICY&lt;/td&gt;&lt;td&gt;REJECTED&lt;/td&gt;&lt;td&gt;причины, K3, альтернативы → D4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Новых статусов нет: вид оферты — поле &lt;i&gt;offerKind&lt;/i&gt;. Решение пишется в audit (снимок входа, версия политики, причины)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#bdbdbd;" vertex="1" parent="1"><mxGeometry x="1720" y="200" width="460" height="400" as="geometry"/></mxCell><mxCell id="w1" value="заявка, оферта, статус&lt;br&gt;REST · SSE" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="apps"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="686" y="345"/><mxPoint x="400" y="345"/></Array></mxGeometry></mxCell><mxCell id="w2" value="GET /insights&lt;br&gt;(блок «Банк заметил»)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.215;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="k2"><mxGeometry x="0.62" relative="1" as="geometry"><Array as="points"><mxPoint x="686" y="640"/></Array></mxGeometry></mxCell><mxCell id="c1" value="политика, ставки, КС" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.82;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="dec"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="345"/><mxPoint x="1101" y="345"/></Array></mxGeometry></mxCell><mxCell id="a1" value="commit" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apps" target="dec"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="a2" value="ISSUED → кредит" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apps" target="loans"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="365"/><mxPoint x="1440" y="365"/></Array></mxGeometry></mxCell><mxCell id="k1k5" value="прогноз" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k1" target="k5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k5k2" value="сигнал" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="k2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k2d" value="simulate" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.164;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2" target="dec"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k2a" value="DRAFT предзаполнен" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2" target="apps"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="656" y="560"/><mxPoint x="560" y="560"/></Array></mxGeometry></mxCell><mxCell id="k3d" value="simulate: что если" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.26;exitY=0;exitDx=0;exitDy=0;entryX=0.586;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3" target="dec"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k4l" value="режим погашения" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="loans"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k1p" value="читает: транзакции 12 мес." style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.185;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k1" target="pg"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k5p" value="читает: контракты ЕИС" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.444;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k5" target="pg"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k4p" value="читает: поступления" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#5b3f6e;strokeWidth=1;endFill=1;strokeColor=#9673a6;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="pg"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1349" y="885"/><mxPoint x="1066" y="885"/></Array></mxGeometry></mxCell><mxCell id="wp" value="снапшоты, события" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk2" target="pg"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wx" value="ручки (kb/09)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrk2" target="ext2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend2" value="&lt;b&gt;Легенда:&lt;/b&gt; голубые — модули основы; фиолетовые — доп. слой K (insights) и его связи; стрелки — «кто кого вызывает или читает». Все модули API пишут в PostgreSQL (на схеме не показано, чтобы не загромождать). Основа → insights — запрещено." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1600" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c4l3w" name="C4 L3-W: Worker и устойчивость"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4, уровень 3: Worker — интеграции, снапшоты и устойчивость (отказы на лету без даунтайма)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1800" height="34" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Для чего:&lt;/b&gt; как Worker делает продукт устойчивым (kb/07_resilience.md). Каждый вызов внешней системы проходит политику: таймаут, ретраи с jitter в одном слое, breaker, bulkhead, проверка контракта. Ответ становится снапшотом с источником и датой, а при отказе движок применяет политику факта (BPMN F1). Шаги конвейера — чекпоинты с арендой: упал воркер — sweeper вернёт шаг, orchestrator продолжит с чекпоинта. Источник вернулся — догоняем ожидающие шаги и пересматриваем решения.&lt;br&gt;&lt;b&gt;Отказы на лету:&lt;/b&gt; песочница (API, только DEMO_MODE) ставит в WireMock стабы отказов с приоритетом 1 поверх штатных (приоритет 5): задержки, обрывы, мусор, 5xx, 429, флаппинг через Scenarios. Ни один контейнер не перезапускается; журнал запросов WireMock показывает, какие вызовы реально ушли.&lt;br&gt;&lt;b&gt;Деньги ровно один раз:&lt;/b&gt; адаптер АБС отправляет Idempotency-Key и делает сверку статуса перед повтором (BPMN F2)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2140" height="112" as="geometry"/></mxCell><mxCell id="api3" value="&lt;b style='font-size:14px'&gt;API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;читает снапшоты и состояние breaker (kv) → баннеры «данные от …»; модуль sandbox (DEMO_MODE) управляет отказами" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="420" height="120" as="geometry"/></mxCell><mxCell id="pg3" value="&lt;b style='font-size:14px'&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[БД]&lt;/span&gt;&lt;br&gt;&lt;br&gt;jobs (шаги, чекпоинты, аренда, таймеры, выдача) · snapshots (TTL, provenance) · kv (breaker) · events (история) · applications" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1040" y="195" width="520" height="150" as="geometry"/></mxCell><mxCell id="bnd_w" value="Worker [тот же Python-пакет, отдельный процесс]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1600" height="520" as="geometry"/></mxCell><mxCell id="disp" value="&lt;b style='font-size:14px'&gt;dispatcher&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;SKIP LOCKED: забирает задачи из jobs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="320" height="130" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b style='font-size:14px'&gt;orchestrator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;шаги конвейера, чекпоинты, аренда, дедлайны; пересмотр (RECHECK)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="320" height="130" as="geometry"/></mxCell><mxCell id="dec3" value="&lt;b style='font-size:14px'&gt;decisioning&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[в процессе worker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;commit и simulate; политики фактов (E1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="320" height="130" as="geometry"/></mxCell><mxCell id="health" value="&lt;b style='font-size:14px'&gt;health&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;breaker по источнику: CLOSED → OPEN → HALF_OPEN; событие integration.health_changed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="420" width="320" height="130" as="geometry"/></mxCell><mxCell id="integ" value="&lt;b style='font-size:14px'&gt;integrations&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент · адаптеры]&lt;/span&gt;&lt;br&gt;&lt;br&gt;ЕГРЮЛ · ЕГРИП · ФНС · ГИР БО · БКИ · МЧД · юр. проверки · банк · АБС · ЕИС&lt;br&gt;на каждый вызов: таймаут · ретраи с jitter (один слой) · breaker · bulkhead · проверка контракта · Idempotency-Key и сверка для АБС" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="710" height="150" as="geometry"/></mxCell><mxCell id="snap3" value="&lt;b style='font-size:14px'&gt;snapshots&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;TTL, stale-while-revalidate, provenance, hash → registry.changed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="320" height="150" as="geometry"/></mxCell><mxCell id="sweep" value="&lt;b style='font-size:14px'&gt;sweeper&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;[компонент]&lt;/span&gt;&lt;br&gt;&lt;br&gt;таймеры и дедлайны, просроченные аренды, снятие отказов по времени (DEMO)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="620" width="320" height="150" as="geometry"/></mxCell><mxCell id="wm" value="&lt;b style='font-size:12px'&gt;WireMock&lt;/b&gt; &lt;span style='font-size:10px'&gt;[мок внешнего мира]&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;/egrul /egrip /fns /girbo /bki /mchd /legal-checks /bank-core /abs /eis&lt;/span&gt;&lt;br&gt;штатные стабы (priority 5) — реальные форматы: ЕГРЮЛ 4.06, XSD ФНС, ГИР БО, ЦБ v3.4, МЧД&lt;br&gt;стабы отказов (priority 1) из песочницы: delay, fault, status, Scenarios&lt;br&gt;журнал запросов /__admin/requests — доказательство вызовов&lt;br&gt;&lt;i&gt;→ внешний мир для демо и тестов&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=6;strokeColor=#736782;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="380" width="460" height="440" as="geometry"/></mxCell><mxCell id="p1" value="SKIP LOCKED: задачи (jobs)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="pg3"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="360"/><mxPoint x="1092" y="360"/></Array></mxGeometry></mxCell><mxCell id="p2" value="API читает снапшоты и breaker (kv)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg3" target="api3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="песочница: POST /__admin/mappings (DEMO_MODE)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api3" target="wm"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="185"/><mxPoint x="1930" y="185"/></Array></mxGeometry></mxCell><mxCell id="w1" value="задача шага" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="disp" target="orch"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w2" value="commit / simulate" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="dec3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w3" value="нужен факт" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.775;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="integ"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w4" value="ответ → снапшот" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="integ" target="snap3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w5" value="успех или отказ" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="integ" target="health"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="754" y="800"/><mxPoint x="1600" y="800"/><mxPoint x="1600" y="485"/></Array></mxGeometry></mxCell><mxCell id="w6" value="источник вернулся → догнать шаги" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="health" target="orch"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="400"/><mxPoint x="694" y="400"/></Array></mxGeometry></mxCell><mxCell id="w7" value="дедлайны, просроченные аренды" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sweep" target="orch"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="590"/><mxPoint x="694" y="590"/></Array></mxGeometry></mxCell><mxCell id="w8" value="HTTP: ручки (kb/09)" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="integ" target="wm"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="293" y="990"/><mxPoint x="1930" y="990"/></Array></mxGeometry></mxCell><mxCell id="legend3" value="&lt;b&gt;Легенда:&lt;/b&gt; голубые — компоненты Worker; серый — WireMock (внешний мир); пунктир — только DEMO_MODE. Все компоненты пишут в PostgreSQL (на схеме — только главное). Внешние ручки вызывает только Worker; API работает на снапшотах и не зависит от доступности реестров." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1600" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>