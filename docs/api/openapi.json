  "components": {
    "schemas": {
      "ApplicationIn": {
        "properties": {
          "inn": {
            "type": "string",
            "pattern": "^\\d{10}$|^\\d{12}$",
            "title": "Inn"
          },
          "product": {
            "type": "string",
            "enum": [
              "OVERDRAFT",
              "EXPRESS",
              "WORKING_CAPITAL",
              "INVESTMENT",
              "CONTRACT",
              "AGRO_SEASONAL"
            ],
            "title": "Product"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "term_months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Term Months"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cash_gap",
                  "stock",
                  "equipment",
                  "growth",
                  "contract"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "consent_bki": {
            "type": "boolean",
            "title": "Consent Bki",
            "description": "согласие на запрос КИ (218-ФЗ ст. 6 ч. 9)",
            "default": false
          },
          "corporate_approval": {
            "type": "boolean",
            "title": "Corporate Approval",
            "description": "решение участников о крупной сделке уже есть",
            "default": false
          },
          "collateral_value": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collateral Value"
          }
        },
        "type": "object",
        "required": [
          "inn",
          "product",
          "amount"
        ],
        "title": "ApplicationIn"
      },
      "FaultIn": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "ключ из policy/sources.yaml: egrul, bki, debtam…"
          },
          "mode": {
            "type": "string",
            "enum": [
              "timeout",
              "error503",
              "reset",
              "garbage",
              "empty"
            ],
            "title": "Mode"
          },
          "inn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{10}$|^\\d{12}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inn",
            "description": "только для этой компании; пусто — для всех"
          }
        },
        "type": "object",
        "required": [
          "source",
          "mode"
        ],
        "title": "FaultIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoanCalcIn": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Term Months"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "% годовых; без ставки — посчитаем по отрасли и классу риска"
          },
          "product": {
            "type": "string",
            "enum": [
              "OVERDRAFT",
              "EXPRESS",
              "WORKING_CAPITAL",
              "INVESTMENT",
              "CONTRACT",
              "AGRO_SEASONAL"
            ],
            "title": "Product",
            "default": "EXPRESS"
          },
          "section": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-U]$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "risk_class": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "title": "Risk Class",
            "default": "B"
          },
          "segment": {
            "type": "string",
            "enum": [
              "IP",
              "LLC",
              "JSC"
            ],
            "title": "Segment",
            "default": "IP"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "term_months"
        ],
        "title": "LoanCalcIn"
      },
      "PersonaIn": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "IP",
              "LLC",
              "JSC"
            ],
            "title": "Kind",
            "default": "LLC"
          },
          "okved": {
            "type": "string",
            "pattern": "^\\d{2}(\\.\\d{1,2}){0,2}$",
            "title": "Okved",
            "description": "ОКВЭД 2: от него отрасль, продукты, спред",
            "default": "62.01"
          },
          "okved_name": {
            "type": "string",
            "title": "Okved Name",
            "default": "Основной вид деятельности"
          },
          "age_months": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Age Months",
            "description": "сколько месяцев бизнесу",
            "default": 36
          },
          "headcount": {
            "type": "integer",
            "maximum": 250.0,
            "minimum": 1.0,
            "title": "Headcount",
            "default": 12
          },
          "inflow_avg": {
            "type": "integer",
            "minimum": 10000.0,
            "title": "Inflow Avg",
            "description": "средние поступления на счёт в месяц, ₽",
            "default": 3000000
          },
          "inflow_cv": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Inflow Cv",
            "description": "разброс поступлений от месяца к месяцу",
            "default": 0.3
          },
          "inflow_trend": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -0.9,
            "title": "Inflow Trend",
            "description": "последние 3 месяца к предыдущим 9, минус 1",
            "default": 0.0
          },
          "debt_load": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Debt Load",
            "description": "платежи по текущим кредитам / поступления",
            "default": 0.15
          },
          "overdue_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Overdue Days",
            "description": "максимальная просрочка в КИ",
            "default": 0
          },
          "bki_requests": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Bki Requests",
            "description": "запросы в БКИ за 30 дней",
            "default": 1
          },
          "tax_debt": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tax Debt",
            "description": "недоимка, ₽",
            "default": 0
          },
          "participants": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Participants",
            "description": "участников ООО",
            "default": 1
          },
          "profit_margin": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Profit Margin",
            "description": "чистая прибыль / выручка",
            "default": 0.05
          },
          "flags": {
            "items": {
              "type": "string",
              "enum": [
                "liquidation",
                "bankruptcy",
                "unreliable_eio",
                "disqualified_eio"
              ]
            },
            "type": "array",
            "title": "Flags",
            "default": []
          },
          "contract_price": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Price",
            "description": "действующий госконтракт в ЕИС, ₽"
          }
        },
        "type": "object",
        "title": "PersonaIn",
        "description": "Своя персона: компания из нескольких параметров. ИНН, ОГРН, люди, выписка и ответы всех источников\nстроятся тем же seed/world.py, что и демо-мир, и проходят ту же проверку корректности."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WhatIfIn": {
        "properties": {
          "facts": {
            "additionalProperties": true,
            "type": "object",
            "title": "Facts",
            "description": "факты в формате features.company_facts"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request",
            "description": "{product, amount, term_months, goal, corporate_approval, collateral_value}"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulate",
              "commit"
            ],
            "title": "Mode",
            "default": "simulate"
          }
        },
        "type": "object",
        "required": [
          "facts",
          "request"
        ],
        "title": "WhatIfIn"
      }
    }
  }
